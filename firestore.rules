// SFE Intelligence — Cloud Firestore güvenlik kuralları (yedek kopya).
// Firebase projesi: sfe-intelligence, veritabanı: (default).
// Bu dosya Firebase'e otomatik yüklenmez; kuralları değiştirdiğinizde
// Firebase Console → Firestore Database → Rules sekmesinden yayımlayın
// ve bu dosyayı aynı içerikle güncelleyin.
//
// Erişim modeli (tek kullanıcı / owner-only):
//  1) İstek, e-postası DOĞRULANMIŞ ve ugur.tr.sahin@gmail.com olan bir
//     oturumdan gelmelidir (Google veya GitHub girişi fark etmez).
//  2) Belge `ownerId` alanında çağıranın uid'sini taşımalıdır.
//  3) Yalnızca uygulamanın kullandığı beş koleksiyona izin verilir;
//     diğer her yol (alt koleksiyonlar dahil) reddedilir.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedOwner() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'ugur.tr.sahin@gmail.com';
    }

    function isAppCollection(col) {
      return col in ['projects', 'sources', 'evidences', 'experiments', 'calculations'];
    }

    match /{col}/{docId} {
      allow read, delete: if isAuthorizedOwner()
        && isAppCollection(col)
        && resource.data.ownerId == request.auth.uid;

      allow create: if isAuthorizedOwner()
        && isAppCollection(col)
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthorizedOwner()
        && isAppCollection(col)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
